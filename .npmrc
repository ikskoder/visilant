shamefully-hoist=true
auto-install-peers=true
# Never let pnpm fetch a different pnpm because package.json names one. The
# version comes from the flake, and an offline build cannot download anything.
manage-package-manager-versions=false
# A version younger than a week is never picked when resolving (pnpm 10.16+,
# in minutes). A hijacked release is usually found and pulled within hours, so
# this keeps one out of the lockfile. A fix that cannot wait is added by hand.
# pnpm 11 reads this from pnpm-workspace.yaml instead, and CI fails if the
# value stops being read.
minimum-release-age=10080
