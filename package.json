{
  "name": "visilant",
  "displayName": "Visilant",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "description": "Browser-extension to provide protection against Homograph Attack & Clone Phishing based on your site visiting statistics",
  "engines": {
    "node": ">=22.21.1",
    "pnpm": ">=10.22.0"
  },
  "scripts": {
    "dev": "npm run clear && cross-env NODE_ENV=development run-p dev:prepare dev:background dev:js dev:frame dev:build",
    "dev-firefox": "npm run clear && cross-env NODE_ENV=development EXTENSION=firefox run-p dev:prepare dev:background dev:js dev:frame dev:build",
    "dev:prepare": "esno scripts/prepare.ts",
    "dev:background": "npm run build:background -- --mode development",
    "dev:server": "vite",
    "dev:build": "vite build --mode development",
    "dev:js": "npm run build:js -- --mode development",
    "dev:frame": "npm run build:frame -- --mode development",
    "build": "cross-env NODE_ENV=production run-s clear build:web build:prepare build:background build:js build:frame",
    "build-firefox": "cross-env EXTENSION=firefox NODE_ENV=production run-s clear build:web build:prepare build:background build:js build:frame",
    "build:prepare": "esno scripts/prepare.ts",
    "build:background": "vite build --config vite.config.background.mts",
    "build:web": "vite build",
    "build:js": "vite build --config vite.config.content.mts",
    "build:frame": "vite build --config vite.config.frame.mts",
    "pack:zip": "esno scripts/pack.ts chrome",
    "pack:crx": "crx pack extension -o ./extension.crx",
    "pack:xpi": "esno scripts/pack.ts firefox",
    "pack:src": "bash scripts/pack-src.sh",
    "start:chromium": "web-ext run --source-dir ./extension --target=chromium",
    "start:firefox": "LD_LIBRARY_PATH= web-ext run --source-dir ./extension --target=firefox-desktop",
    "start:firefox-android": "LD_LIBRARY_PATH= web-ext run --source-dir ./extension --target=firefox-android",
    "start:firefox:wait": "node -e \"const fs=require('fs'); const sleep=ms=>new Promise(r=>setTimeout(r,ms)); (async()=>{while(fs.existsSync('extension/manifest.json'))await sleep(200);while(!fs.existsSync('extension/manifest.json'))await sleep(200);})()\" && npm run start:firefox",
    "clear": "rimraf --glob extension/dist extension/manifest.json extension.* artifacts",
    "lint": "eslint --cache .",
    "test": "NODE_OPTIONS='--disable-warning=MODULE_TYPELESS_PACKAGE_JSON' vitest test",
    "test:e2e": "playwright test",
    "test:android": "esno e2e-android/run.ts",
    "postinstall": "simple-git-hooks",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.2.8",
    "jsqr": "^1.4.0",
    "punycode": "^2.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.3.0",
    "@iconify-json/carbon": "^1.2.20",
    "@iconify/json": "^2.2.310",
    "@playwright/test": "^1.50.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.5",
    "@types/punycode": "^2.1.4",
    "@types/webextension-polyfill": "^0.12.2",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@unocss/reset": "66.6.7",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^12.7.0",
    "chokidar": "^4.0.3",
    "cross-env": "^7.0.3",
    "crx": "^5.0.1",
    "eslint": "^9.21.0",
    "esno": "^4.8.0",
    "fs-extra": "^11.3.0",
    "jsdom": "^26.0.0",
    "jszip": "^3.10.1",
    "kolorist": "^1.8.0",
    "lint-staged": "^15.4.3",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "simple-git-hooks": "^2.11.1",
    "tldts": "^7.0.18",
    "typescript": "^5.7.3",
    "unocss": "66.6.7",
    "unplugin-auto-import": "^19.1.0",
    "unplugin-icons": "^22.1.0",
    "unplugin-vue-components": "^28.4.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "vue": "^3.5.13",
    "vue-demi": "^0.14.10",
    "web-ext": "^8.4.0",
    "webext-bridge": "^6.0.1",
    "webextension-polyfill": "^0.12.0"
  },
  "simple-git-hooks": {
    "pre-commit": "./scripts/pre-commit.sh"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
