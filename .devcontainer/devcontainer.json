{
  "name": "Visilant",
  // The Dev Containers extension passes -f explicitly, which turns off
  // Compose's automatic pickup of compose.override.yaml, so it is listed here.
  // The file is gitignored and machine-specific, and initializeCommand creates
  // it from the example when it is missing, because Compose refuses a -f file
  // that does not exist.
  "dockerComposeFile": ["compose.yaml", "compose.override.yaml"],
  "service": "workspace",

  // Runs on the host before Compose reads anything. It writes .env with the
  // checkout's path, so the project sits at the same absolute path in the
  // container as on the host, and creates the override above if needed. The
  // array form keeps a path with a space in it one argument.
  "initializeCommand": ["bash", "${localWorkspaceFolder}/.devcontainer/scripts/workspace-env.sh", "${localWorkspaceFolder}"],
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "root",

  // Deliberately empty, and it has to stay that way. A Dev Container Feature
  // carries `capAdd` and `securityOpt` in its metadata, the CLI unions those
  // across every entry, and Compose appends list values - so one Feature here
  // would give the container back capabilities that cap_drop: ALL cannot
  // remove. Anything a Feature would install belongs in the Dockerfile.
  "features": {},

  // Create-time checks the image, start-time checks the mounts. Keeping them
  // apart matters because a failed postCreateCommand prints "Skipping any
  // further user-provided commands" and postStartCommand then never runs at
  // all, which silently disables every check after it.
  // The container's node_modules is a volume of its own and is empty on a
  // fresh create, so the install belongs here rather than in a README step
  // somebody skips.
  "postCreateCommand": "pnpm install --frozen-lockfile && bash .devcontainer/scripts/check-workspace.sh",
  "postStartCommand": "bash .devcontainer/scripts/check-workspace.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "vue.volar",
        "antfu.iconify",
        "antfu.unocss",
        "dbaeumer.vscode-eslint",
        "csstools.postcss"
      ],
      "settings": {
        "typescript.tsdk": "node_modules/typescript/lib",
        "eslint.experimental.useFlatConfig": true,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
